# Production Environment Variables for Backend
# Copy this file to .env.production and fill in your actual values

# OpenAI Configuration (REQUIRED for AI features)
OPENAI_API_KEY=your-production-openai-api-key

# Firebase Configuration (REQUIRED)
GOOGLE_APPLICATION_CREDENTIALS=base64-encoded-firebase-service-account-key

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=production
LOGGING_LEVEL=INFO

# Frontend URL for CORS (REQUIRED)
FRONTEND_URL=https://your-frontend-production-url.com

# Database Configuration (Optional - when database is added)
# SPRING_DATASOURCE_URL=jdbc:postgresql://user:password@host:port/database
# SPRING_DATASOURCE_USERNAME=your-username
# SPRING_DATASOURCE_PASSWORD=your-password
